generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  COLLABORATEUR
  MANAGER
  ADMINISTRATEUR
}

enum StatutTache {
  BROUILLON
  SOUMISE
  VALIDEE
  REJETEE
}

model Utilisateur {
  id         String   @id @default(uuid())
  nom        String
  prenom     String
  email      String   @unique
  motDePasse String
  role       Role     @default(COLLABORATEUR)
  creeLe     DateTime @default(now())
  modifieLe  DateTime @updatedAt

  tachesCreees   Tache[] @relation("Createur")
  tachesTraitees Tache[] @relation("Validateur")

  @@map("utilisateurs")
}

model Tache {
  id               String      @id @default(uuid())
  titre            String      @db.VarChar(150)
  description      String
  statut           StatutTache @default(BROUILLON)
  commentaireRejet String?
  creeLe           DateTime    @default(now())
  modifieLe        DateTime    @updatedAt

  createurId   String
  createur     Utilisateur  @relation("Createur", fields: [createurId], references: [id], onDelete: Cascade)
  validateurId String?
  validateur   Utilisateur? @relation("Validateur", fields: [validateurId], references: [id], onDelete: SetNull)

  @@index([createurId])
  @@index([statut])
  @@map("taches")
}